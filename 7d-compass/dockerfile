
# Build Stage
FROM node:18 AS build

WORKDIR /app

COPY package*.json ./
RUN npm install --legacy-peer-deps

COPY . .
RUN npm run build -- --configuration=production

# Runtime Stage
FROM node:18-alpine

WORKDIR /app

# Copy both server and browser files from the build
COPY --from=build /app/dist/7d-compass/server ./server
COPY --from=build /app/dist/7d-compass/browser ./browser

EXPOSE 3005

# Set the port environment variable for the SSR server
ENV PORT=3005

# Run the SSR server instead of http-server
CMD ["node", "server/server.mjs"]

# =============================================================================
# PREVIOUS STATIC FILE SERVING CONFIGURATION (COMMENTED OUT)
# =============================================================================
# If you need to revert to static file serving, uncomment these lines and comment out the SSR lines above:

