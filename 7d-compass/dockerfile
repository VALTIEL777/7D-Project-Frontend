# Build Angular app
FROM node:18 AS build

WORKDIR /app
COPY package*.json ./
RUN npm install --legacy-peer-deps
COPY . .
RUN npm run build --prod

# Production stage with lightweight HTTP server
FROM node:18-alpine

WORKDIR /app

# Install http-server globally
RUN npm install -g http-server

# Copy built Angular app
COPY --from=build /app/dist/7d-compass/browser ./dist

# Expose port 3005
EXPOSE 3005

# Start http-server with specific configuration to prevent redirects
CMD ["http-server", "dist", "-p", "3005", "-a", "0.0.0.0", "--cors", "-P", "http://localhost:3005?"]
